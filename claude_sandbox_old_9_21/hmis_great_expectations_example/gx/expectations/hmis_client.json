    {
      "description": "Full SSN follows SSA rules (9 digits; area not 000/666/9xx; group not 00; serial not 0000)",
      "id": "200a0575-c481-4810-bbd6-b6ff29365ddc",
      "kwargs": {
        "column": "SSN",
        "regex": "^(?!000|666|9)\\d{3}(?!00)\\d{2}(?!0000)\\d{4}$",
        "row_condition": {
          "column": {
            "name": "SSNDataQuality"
          },
          "operator": "==",
          "parameter": 1,
          "type": "comparison"
        }
      },
      "meta": {
        "data_element": "3.02 SSN",
        "hud_reference": "APR Q6a"
      },
      "severity": "critical",
      "type": "expect_column_values_to_match_regex"
    },
    {
